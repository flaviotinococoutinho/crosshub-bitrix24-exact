# Copie para .env apenas em uma instalacao nova. O ambiente do processo tem precedencia.
# Nao substitua um .env existente. Aspas sao literais; nao ha interpolacao.
BTX_HOOK='https://example.invalid/rest/1/change-me'
# Para dados privados do cliente, use config/bitrix-mappings.local.php (ignorado).
BTX_MAPPINGS_FILE='config/bitrix-mappings.php'
EXACT_TOKEN_ALUGUEL='change-me'
EXACT_TOKEN_VENDAS='change-me'
EXACT_TOKEN_CAPTACAO_LOCACAO='change-me'
EXACT_TOKEN_CAPTACAO_VENDAS='change-me'
EXACT_TOKEN_ALUGUEL_ESPECIAL='change-me'
APP_TIMEZONE='America/Sao_Paulo'
BTX_SSL_VERIFY_PEER='false'
HTTP_TIMEOUT_SECONDS='0'
LOG_DRIVER='file'
LOG_DIR='storage/logs'
LOG_MAX_BYTES='10485760'
LOG_BACKUP_COUNT='5'
EXACT_ADD_URL='https://api.spotter.exactsales.com.br/api/v2/leads'
EXACT_GET_URL='https://api.exactsales.com.br/v2/listarlead?id='
EXACT_RECOVER_URL='https://api.exactsales.com.br/v2/recuperarLead'
EXACT_UPDATE_URL='https://api.exactsales.com.br/v2/editarlead'
